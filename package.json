{
  "name": "mistboard",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,web --prefix-colors blue,green 'npm run dev --workspace @mistboard/server' 'npm run dev --workspace @mistboard/web'",
    "dev:persistent": "concurrently --kill-others-on-fail --names server,web --prefix-colors blue,green 'npm run dev:persistent --workspace @mistboard/server' 'npm run dev --workspace @mistboard/web'",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run migrate --workspace @mistboard/server",
    "db:seed:profiles": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run seed:profiles --workspace @mistboard/server",
    "db:seed:watch": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run seed:watch --workspace @mistboard/server",
    "test:persistent": "env TEST_DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run test:persistent --workspace @mistboard/server",
    "build": "node scripts/build.mjs",
    "build:all": "npm run build --workspaces",
    "start": "node scripts/start.mjs",
    "engine:enqueue": "npm run engine:enqueue --workspace=@mistboard/server",
    "engine:enqueue-smoke": "npm run engine:enqueue-smoke --workspace=@mistboard/server",
    "engine:enqueue-tournament": "npm run engine:enqueue-tournament --workspace=@mistboard/server",
    "engine:elo-report": "npm run engine:elo-report --workspace=@mistboard/server",
    "engine:queue-status": "npm run engine:queue-status --workspace=@mistboard/server",
    "engine:tournament-status": "npm run engine:tournament-status --workspace=@mistboard/server",
    "ops:test-engine-alert": "npm run ops:test-engine-alert --workspace=@mistboard/server --",
    "worker": "npm run worker --workspace=@mistboard/server",
    "worker:execute": "npm run worker:execute --workspace=@mistboard/server",
    "worker:service": "npm run worker:service --workspace=@mistboard/server",
    "worker:dev": "npm run worker:dev --workspace=@mistboard/server",
    "worker:dev:execute": "npm run worker:dev:execute --workspace=@mistboard/server",
    "worker:dev:service": "npm run worker:dev:service --workspace=@mistboard/server",
    "engine:artifact-archive": "node scripts/archive-engine-artifact.mjs",
    "engine:artifact-audit": "node scripts/engine-artifact-audit.mjs",
    "engine:artifact-closeout": "node scripts/engine-artifact-closeout.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check:cycles": "madge --circular --extensions ts apps packages",
    "agent:scan": "node scripts/agent-scan.mjs",
    "gate:evidence": "node scripts/gate-evidence.mjs",
    "check:drift": "node scripts/drift-check.mjs",
    "worktree:new": "node scripts/worktree-new.mjs",
    "worktree:prepare": "node scripts/worktree-prepare.mjs",
    "verify": "node scripts/verify.mjs",
    "ci:quick": "node scripts/ci-checks.mjs quick",
    "ci:local": "node scripts/ci-checks.mjs local",
    "ci:browser-smoke:plan": "node scripts/ci-browser-smoke-plan.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "visual:check": "node scripts/visual-check.mjs",
    "mobile:loop": "node scripts/mobile-loop.mjs",
    "test:e2e:smoke": "npm run visual:check",
    "test:auth:local": "node scripts/auth-nav-smoke.mjs",
    "test:dark-xiangqi:persistent": "npm run test:dark-xiangqi:persistent --workspace @mistboard/web",
    "test:mobile:shots": "npm run mobile:loop",
    "engine:capture-beliefs": "node scripts/capture-belief-artifacts.mjs",
    "release:local-smoke": "node scripts/release-local-smoke.mjs",
    "release:prod": "node scripts/release-prod.mjs",
    "deploy:engine-worker": "node scripts/deploy-engine-worker.mjs",
    "prod:smoke:plan": "node scripts/prod-smoke-plan.mjs",
    "prod:wait-revision": "node scripts/wait-prod-revision.mjs",
    "prod:smoke:lite": "node scripts/prod-lite-smoke.mjs",
    "prod:smoke": "node scripts/prod-smoke.mjs",
    "prod:smoke:engines": "node scripts/prod-engine-smoke.mjs",
    "prod:smoke:dmx": "node scripts/prod-dmx-smoke.mjs",
    "prod:smoke:engine-playout": "node scripts/prod-engine-playout.mjs",
    "time:command": "node scripts/time-command.mjs",
    "research:kqk-belief": "tsx scripts/fow-kqk-belief.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "^1.59.1",
    "concurrently": "10.0.3",
    "madge": "8.0.0"
  }
}
